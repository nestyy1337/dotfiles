# Ignore everything
*

# Allow gitignore
!.gitignore

# Allow directories
!/*/

# Ignore all directories by default
/*/*

# Whitelist specific directories
!/bin/**
!/editor/**
!/gui/**
!/shell/**
!README.md

# Machine-local agent settings are never shared
**/.claude/settings.local.json

# System config is its own private repo (nestyy1337/nixos-config)
/nixos/
